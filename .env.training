# `vite build --mode training` (the «Deploy Training Copy» workflow): the same app pointed at the training copy on netcup.
# Non-secret build config, like .env.production. https://train-lms.mastereducation.kz
VITE_APP_ENV=training
VITE_BACKEND_URL=https://train-lmsapi.mastereducation.kz
VITE_APP_NAME=LMS Platform (training)
VITE_LMS_ORIGIN=https://train-lms.mastereducation.kz
VITE_CRM_WEB_URL=https://train-crm.mastereducation.kz
# No other platform exists in the copy; these point at itself, so no link leads to production.
VITE_SAT_PLATFORM_URL=https://train-lms.mastereducation.kz
VITE_NUET_PLATFORM_URL=https://train-lms.mastereducation.kz
VITE_IELTS_PLATFORM_URL=https://train-lms.mastereducation.kz

# SSO: none in the copy. The one way in is the signed link from «Открыть тренажёр» (/training-login).
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# No error tracking, no captcha.
VITE_SENTRY_DSN=
VITE_TURNSTILE_SITE_KEY=
