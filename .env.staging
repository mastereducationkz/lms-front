# `vite build --mode staging` (the «Deploy to staging» workflow): the same app pointed at staging.
# Non-secret build config, like .env.production. https://stage-lms.mastereducation.kz
VITE_APP_ENV=staging
VITE_BACKEND_URL=https://stage-lmsapi.mastereducation.kz
VITE_APP_NAME=LMS Platform (staging)
VITE_LMS_ORIGIN=https://stage-lms.mastereducation.kz
VITE_CRM_WEB_URL=https://stage-crm.mastereducation.kz
VITE_SAT_PLATFORM_URL=https://stage-sat.mastereducation.kz
VITE_NUET_PLATFORM_URL=https://stage-sat.mastereducation.kz
VITE_IELTS_PLATFORM_URL=https://stage-ielts.mastereducation.kz

# SSO: no staging app in Zitadel yet (STAGING.md, «SSO»), so the button stays hidden and
# staging uses the email/password login of the seeded accounts.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
